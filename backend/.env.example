# Copy to backend/.env and fill in only the values you want to override.
# Keep secrets in backend/.env. That file is gitignored.

MOODWAVE_DATA_DIR=./data
MOODWAVE_DB_PATH=./data/moodwave.db
MOODWAVE_HOST=127.0.0.1
MOODWAVE_PORT=8000
MOODWAVE_SEED=42
MOODWAVE_LOG_LEVEL=INFO
MOODWAVE_CATALOG_SOURCE=itunes
MOODWAVE_ITUNES_COUNTRY=US
MOODWAVE_YTMUSIC_LOCATION=IN
MOODWAVE_YTMUSIC_EMBED_CHECK=1

# Optional. Create these in the Spotify developer dashboard.
# Leave them empty to skip Spotify search. The playlist page uses YouTube Music.
MOODWAVE_SPOTIFY_CLIENT_ID=
MOODWAVE_SPOTIFY_CLIENT_SECRET=

# Extra browser origins for a hosted site, comma-separated. GitHub Pages is already allowed.
# MOODWAVE_CORS_ORIGINS=https://example.github.io

# Optional. A CSV replaces the Apple Music catalog.
# MOODWAVE_CATALOG_CSV=./data/my_catalog.csv
# MOODWAVE_INTERACTIONS_JSON=./data/my_interactions.json
